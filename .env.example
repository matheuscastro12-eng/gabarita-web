# Gabarita — variáveis de ambiente (copie para .env.local; nunca commite segredos)

# Interface do tutor de IA. Desligada por padrão: o painel, os atalhos, os
# ajustes e os textos somem. O código permanece. Para religar, use 1 e faça
# um novo build (o Next embute NEXT_PUBLIC_ na compilação).
# NEXT_PUBLIC_TUTOR_VISIVEL=1

# Chave da API da Anthropic usada pelo tutor de IA. Sem ela, e com a interface
# ligada, o app funciona em "modo guiado offline" (dicas verificadas do banco PROVAS).
ANTHROPIC_API_KEY=

# Alternativa: chave do Vercel AI Gateway (usada se ANTHROPIC_API_KEY estiver vazia).
AI_GATEWAY_API_KEY=

# Modelo do tutor. Confira o ID atual na documentação da Anthropic.
TUTOR_MODEL=claude-sonnet-5-5

# Origem do banco de questões para scripts/sync-provas.ts (opcional).
# Padrão: ../PROVAS (checkout local) e, se não existir, GitHub raw.
PROVAS_DIR=
PROVAS_GIT_REF=main

# Esforço de raciocínio do modelo do tutor: low (padrão, mais rápido), medium ou high.
TUTOR_EFFORT=low
